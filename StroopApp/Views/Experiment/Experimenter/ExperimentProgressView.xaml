<UserControl x:Class="StroopApp.Views.Experiment.Experimenter.ExperimentProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:StroopApp.Converters"
             xmlns:local="clr-namespace:StroopApp.Views.Experiment.Experimenter"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:MillisecondsToHoursConverter x:Key="MillisecondsToHoursConverter" />
        <converters:MillisecondsToMinutesConverter x:Key="MillisecondsToMinutesConverter" />
        <converters:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityInvertedConverter x:Key="BoolToVisibilityInvertedConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                CornerRadius="8,0,0,8"
                Padding="16"
                BorderThickness="0.5"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ui:SimpleStackPanel Orientation="Vertical"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top"
                                 Spacing="16">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Title_Progress]}"
                           Style="{DynamicResource TitleTextBlockStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="0"
                           FontSize="14"
                           HorizontalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} %">
                            <Binding Path="Progress"
                                     Mode="OneWay" />
                        </MultiBinding>
                    </TextBlock.Text></TextBlock>
                <ui:ProgressBar Grid.Column="1"
                                Value="{Binding Progress, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Height="10" />
            </ui:SimpleStackPanel>
        </Border>
        <Border Grid.Column="1"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                Padding="16"
                BorderThickness="0.5"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ui:SimpleStackPanel Spacing="10">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Title_ParticipantDetails]}"
                           Style="{DynamicResource TitleTextBlockStyle}" />
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Settings.Participant.Id, Mode=OneTime}"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_ParticipantId]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             IsHitTestVisible="False"
                             Padding="4"
                             Margin="4" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Settings.Block}"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_BlockNumber]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             IsHitTestVisible="False"
                             Padding="4"
                             Margin="4" />
                </Grid>
            </ui:SimpleStackPanel>
        </Border>
        <Border Grid.Column="2"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                CornerRadius="0,8,8,0"
                Padding="16"
                BorderThickness="0.5"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ui:SimpleStackPanel Spacing="10">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Title_ExperimentDetails]}"
                           Style="{DynamicResource TitleTextBlockStyle}" />
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Settings.CurrentProfile.CongruencePercent, Mode=OneTime}"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_Congruence_Percent]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             IsHitTestVisible="False"
                             Padding="4"
                             Margin="4" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Settings.CurrentProfile.SwitchPercent, Mode=OneTime}"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_Switch]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             IsHitTestVisible="False"
                             Padding="4"
                             Margin="4"
                             Visibility="{Binding Settings.CurrentProfile.HasVisualCue, Mode=OneTime,
                               Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox Grid.Column="2"
                             Text="{Binding Settings.CurrentProfile.Hours, Mode=OneTime}"
                             IsReadOnly="True"
                             HorizontalAlignment="Center"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_Hours]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                    <TextBox Grid.Column="3"
                             Text="{Binding Settings.CurrentProfile.Minutes, Mode=OneTime}"
                             IsReadOnly="True"
                             HorizontalAlignment="Center"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_Minutes]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                    <TextBox Grid.Column="4"
                             Text="{Binding Settings.CurrentProfile.Seconds, Mode=OneTime}"
                             IsReadOnly="True"
                             HorizontalAlignment="Center"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_Seconds]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                    <TextBox Grid.Column="5"
                             Text="{Binding Settings.CurrentProfile.MaxReactionTime, Mode=OneTime}"
                             IsReadOnly="True"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_MaxResponseTime]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                    <TextBox Grid.Column="6"
                             Text="{Binding Settings.CurrentProfile.WordDuration, Mode=OneTime}"
                             IsReadOnly="True"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_WordDuration]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityInvertedConverter}}" />
                    <TextBox Grid.Column="5"
                             Text="{Binding CurrentCalibrationPhase, Mode=OneWay}"
                             IsReadOnly="True"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_CalibrationCurrentPhase]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox Grid.Column="6"
                             Text="{Binding CurrentPresentationTime, Mode=OneWay}"
                             IsReadOnly="True"
                             HorizontalAlignment="Stretch"
                             ui:ControlHelper.Header="{Binding Source={StaticResource Loc}, Path=[Header_PresentationTime]}"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             Padding="4"
                             Margin="4"
                             IsHitTestVisible="False"
                             Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </ui:SimpleStackPanel>
        </Border>
    </Grid>
</UserControl>
